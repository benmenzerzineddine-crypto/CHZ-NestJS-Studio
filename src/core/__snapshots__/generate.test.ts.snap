    "content": "import { PostStatus } from "../../common/enums";
import type { User } from "../../users/entities/user.entity";
import type { Comment } from "../comment/comment.entity";
import type { Tag } from "../tag/tag.entity";
import {
  Column,
  CreateDateColumn,
  DeleteDateColumn,
  Entity,
  Index,
  JoinColumn,
  JoinTable,
  ManyToMany,
  ManyToOne,
  OneToMany,
  PrimaryGeneratedColumn,
  UpdateDateColumn,
} from "typeorm";

@Entity("posts")
export class Post {
  @PrimaryGeneratedColumn("uuid", { name: "id" })
  id: string;

  @Column({ type: "varchar", length: 160, name: "title", nullable: false })
  title: string;

  @Index()
  @Column({ type: "varchar", length: 180, name: "slug", nullable: false, unique: true })
  slug: string;

  @Column({ type: "text", name: "content", nullable: false })
  content: string;

  @Index()
  @Column({
    type: "enum",
    enum: PostStatus,
    enumName: "posts_status",
    name: "status",
    nullable: false,
  })
  status: PostStatus;

  @Column({ type: "timestamptz", name: "published_at", nullable: true })
  publishedAt?: Date | null;

  @Column({ type: "int", name: "views", nullable: false, default: 0 })
  views: number;

  @CreateDateColumn({ name: "created_at", type: "timestamptz" })
  createdAt: Date;

  @UpdateDateColumn({ name: "updated_at", type: "timestamptz" })
  updatedAt: Date;

  @DeleteDateColumn({ name: "deleted_at", type: "timestamptz", nullable: true })
  deletedAt?: Date;

  @Index()
  @Column({ name: "author_id", type: "uuid", nullable: false })
  authorId: string;

  @ManyToOne("User", { nullable: false })
  @JoinColumn({ name: "author_id", referencedColumnName: "id" })
  author: User;

  @Index()
  @Column({ name: "owner_id", type: "uuid", nullable: true })
  ownerId?: string;

  @ManyToOne("User", { nullable: true, onDelete: "CASCADE" })
  @JoinColumn({ name: "owner_id", referencedColumnName: "id" })
  owner?: User | null;

  @ManyToMany("Tag")
  @JoinTable({
    name: "posts_tags",
    joinColumn: { name: "post_id", referencedColumnName: "id" },
    inverseJoinColumn: { name: "tag_id", referencedColumnName: "id" },
  })
  tags: Tag[];

  @OneToMany("Comment", "post")
  comments: Comment[];
}
