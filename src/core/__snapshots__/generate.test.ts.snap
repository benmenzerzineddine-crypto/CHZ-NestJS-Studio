    "content": "import type { INestApplication } from "@nestjs/common";
import { DocumentBuilder, SwaggerModule } from "@nestjs/swagger";

export function setupSwagger(app: INestApplication, apiPrefix: string, bearerAuth: boolean): void {
  const builder = new DocumentBuilder()
    .setTitle("Blog API")
    .setDescription("Generated NestJS + TypeORM REST API")
    .setVersion("1.0");

  if (bearerAuth) builder.addBearerAuth();
  const document = SwaggerModule.createDocument(app, builder.build());
  SwaggerModule.setup(\`\${apiPrefix}/docs\`, app, document);
}
