    "content": "import type { Post } from "../post/post.entity";
import {
  Column,
  CreateDateColumn,
  Entity,
  Index,
  ManyToMany,
  PrimaryGeneratedColumn,
  UpdateDateColumn,
} from "typeorm";

@Entity("tags")
export class Tag {
  @PrimaryGeneratedColumn("uuid", { name: "id" })
  id: string;

  @Index()
  @Column({ type: "varchar", length: 80, name: "name", nullable: false, unique: true })
  name: string;

  @CreateDateColumn({ name: "created_at", type: "timestamptz" })
  createdAt: Date;

  @UpdateDateColumn({ name: "updated_at", type: "timestamptz" })
  updatedAt: Date;

  @ManyToMany("Post", "tags")
  posts: Post[];
}
