  {
    "content": "import { INestApplication } from "@nestjs/common";
import { randomUUID } from "node:crypto";
import request from "supertest";
import { DataSource } from "typeorm";
import { Post } from "../src/modules/post/post.entity";
import { authHeader, createTestApp, createUser, login } from "./utils/auth";
import { listItems, unique } from "./utils/db";
import { createFactories } from "./utils/factories";

jest.setTimeout(30_000);

describe("Post CRUD", () => {
  let app: INestApplication;
  let dataSource: DataSource;
  let factory: ReturnType<typeof createFactories>;
  let sample: Post;
  let adminToken = "";
  let ownerToken = "";
  let otherToken = "";
  let creatorToken = "";

  beforeAll(async () => {
    app = await createTestApp();
    dataSource = app.get(DataSource);
    const owner = await createUser(app, ["user"]);
    const other = await createUser(app, ["user"]);
    const admin = await createUser(app, ["admin"]);
    adminToken = await login(app, admin.email);
    ownerToken = await login(app, owner.email);
    otherToken = await login(app, other.email);
    const creator = await createUser(app, ["admin", "user", "editor"]);
    creatorToken = await login(app, creator.email);
    factory = createFactories({
      app,
      dataSource,
      tokens: {
        admin: adminToken,
        owner: ownerToken,
        other: otherToken,
        creator: creatorToken,
      },
      ownerId: owner.id,
    });
    sample = await factory.makePost(unique("post"), creatorToken);
  });

  afterAll(async () => {
    await app.close();
  });

  it("creates a Post", async () => {
    const payload = await factory.buildPost(unique("post-create"));
    const response = await request(app.getHttpServer())
      .post("/api/posts")
      .set(authHeader(creatorToken))
      .send(payload);
    expect(response.status).toBe(201);
  });

  it("lists Post records", async () => {
    const response = await request(app.getHttpServer()).get("/api/posts").set(authHeader(null));
    expect(response.status).toBe(200);
    expect(listItems(response.body).some((item) => item["id"] === sample.id)).toBe(true);
  });

  it("paginates Post records", async () => {
    const response = await request(app.getHttpServer())
      .get("/api/posts?limit=1&page=1")
      .set(authHeader(null));
    expect(response.status).toBe(200);
    expect(response.body.meta).toMatchObject({ page: 1, limit: 1 });
    expect(response.body.meta.totalPages).toBeGreaterThanOrEqual(1);
  });

  it("rejects invalid Post list queries", async () => {
    const badLimit = await request(app.getHttpServer())
      .get("/api/posts?limit=101")
      .set(authHeader(null));
    expect(badLimit.status).toBe(400);
    const badSort = await request(app.getHttpServer())
      .get("/api/posts?sort=__not_a_field__")
      .set(authHeader(null));
    expect(badSort.status).toBe(400);
  });

  it("filters Post records", async () => {
    const value = encodeURIComponent(String(sample.title));
    const response = await request(app.getHttpServer())
      .get(\`/api/posts?title=\${value}\`)
      .set(authHeader(null));
    expect(response.status).toBe(200);
    expect(listItems(response.body).some((item) => item["id"] === sample.id)).toBe(true);
  });

  it("reads a Post", async () => {
    const response = await request(app.getHttpServer())
      .get(\`/api/posts/\${sample.id}\`)
      .set(authHeader(null));
    expect(response.status).toBe(200);
    expect(response.body.id).toBe(sample.id);
  });

  it("updates a Post", async () => {
    const payload = await factory.buildPost(unique("post-update"));
    const response = await request(app.getHttpServer())
      .patch(\`/api/posts/\${sample.id}\`)
      .set(authHeader(ownerToken))
      .send({ title: payload.title });
    expect(response.status).toBe(200);
  });

  it("deletes and restores a Post", async () => {
    const row = await factory.makePost(unique("post-delete"), creatorToken);
    const removed = await request(app.getHttpServer())
      .delete(\`/api/posts/\${row.id}\`)
      .set(authHeader(creatorToken));
    expect(removed.status).toBe(204);
    const missing = await request(app.getHttpServer())
      .get(\`/api/posts/\${row.id}\`)
      .set(authHeader(null));
    expect(missing.status).toBe(404);
    const forbidden = await request(app.getHttpServer())
      .get("/api/posts?withDeleted=true")
      .set(authHeader(otherToken));
    expect(forbidden.status).toBe(403);
    const withDeleted = await request(app.getHttpServer())
      .get("/api/posts?withDeleted=true")
      .set(authHeader(creatorToken));
    expect(withDeleted.status).toBe(200);
    expect(listItems(withDeleted.body).some((item) => item["id"] === row.id)).toBe(true);
    const restored = await request(app.getHttpServer())
      .post(\`/api/posts/\${row.id}/restore\`)
      .set(authHeader(creatorToken));
    expect(restored.status).toBe(204);
    const afterRestore = await request(app.getHttpServer())
      .get(\`/api/posts/\${row.id}\`)
      .set(authHeader(null));
    expect(afterRestore.status).toBe(200);
  });

  it("rejects invalid Post input", async () => {
    const payload: Record<string, unknown> = {
      title: null,
    };
    const response = await request(app.getHttpServer())
      .post("/api/posts")
      .set(authHeader(creatorToken))
      .send(payload);
    expect(response.status).toBe(400);
  });

  it("returns 404 for a missing Post", async () => {
    const missingId = randomUUID();
    const response = await request(app.getHttpServer())
      .get(\`/api/posts/\${missingId}\`)
      .set(authHeader(null));
    expect(response.status).toBe(404);
  });
});
