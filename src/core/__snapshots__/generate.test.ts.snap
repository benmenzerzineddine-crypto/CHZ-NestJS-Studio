  {
    "content": "import { CurrentUser } from "../../auth/decorators/current-user.decorator";
import { Public } from "../../auth/decorators/public.decorator";
import { Roles } from "../../auth/decorators/roles.decorator";
import { AuthUser } from "../../auth/interfaces/auth-user.interface";
import { CreatePostDto } from "./dto/create-post.dto";
import { PaginatedPostDto } from "./dto/paginated-post.dto";
import { QueryPostDto } from "./dto/query-post.dto";
import { UpdatePostDto } from "./dto/update-post.dto";
import { Post as PostEntity } from "./post.entity";
import { PostService } from "./post.service";
import {
  Body,
  Controller,
  Delete,
  Get,
  HttpCode,
  Param,
  ParseUUIDPipe,
  Patch,
  Post,
  Query,
} from "@nestjs/common";
import {
  ApiBadRequestResponse,
  ApiBearerAuth,
  ApiCreatedResponse,
  ApiForbiddenResponse,
  ApiNoContentResponse,
  ApiNotFoundResponse,
  ApiOkResponse,
  ApiOperation,
  ApiTags,
  ApiUnauthorizedResponse,
} from "@nestjs/swagger";

@ApiTags("posts")
@Controller("posts")
export class PostController {
  constructor(private readonly service: PostService) {}

  @ApiOperation({ summary: "List Post records" })
  @ApiOkResponse({ description: "Paginated Post list", type: PaginatedPostDto })
  @ApiBadRequestResponse({ description: "Invalid query parameters" })
  @Public()
  @Get()
  findAll(@Query() query: QueryPostDto, @CurrentUser() user?: AuthUser) {
    return this.service.findAll(query, user);
  }

  @ApiOperation({ summary: "Get one Post" })
  @ApiOkResponse({ description: "Post found", type: PostEntity })
  @ApiNotFoundResponse({ description: "Record not found" })
  @Public()
  @Get(":id")
  findOne(@Param("id", ParseUUIDPipe) id: string, @CurrentUser() user?: AuthUser) {
    return this.service.findOne(id, user);
  }

  @ApiOperation({ summary: "Create a Post" })
  @ApiCreatedResponse({ description: "Post created", type: PostEntity })
  @ApiBadRequestResponse({ description: "Validation failed" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiBearerAuth()
  @Post()
  create(@Body() dto: CreatePostDto, @CurrentUser() user?: AuthUser) {
    return this.service.create(dto, user);
  }

  @ApiOperation({ summary: "Update a Post" })
  @ApiOkResponse({ description: "Post updated", type: PostEntity })
  @ApiBadRequestResponse({ description: "Validation failed" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiForbiddenResponse({ description: "Insufficient permissions" })
  @ApiNotFoundResponse({ description: "Record not found" })
  @ApiBearerAuth()
  // Admin bypass and owner scoping are enforced by the service query.
  @Patch(":id")
  update(
    @Param("id", ParseUUIDPipe) id: string,
    @Body() dto: UpdatePostDto,
    @CurrentUser() user?: AuthUser,
  ) {
    return this.service.update(id, dto, user);
  }

  @ApiOperation({ summary: "Delete a Post" })
  @ApiNoContentResponse({ description: "Post deleted" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiForbiddenResponse({ description: "Insufficient permissions" })
  @ApiNotFoundResponse({ description: "Record not found" })
  @ApiBearerAuth()
  @Roles("admin")
  @Delete(":id")
  @HttpCode(204)
  async remove(
    @Param("id", ParseUUIDPipe) id: string,
    @CurrentUser() user?: AuthUser,
  ): Promise<void> {
    await this.service.remove(id, user);
  }

  @ApiOperation({ summary: "Restore a soft-deleted Post" })
  @ApiNoContentResponse({ description: "Post restored" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiForbiddenResponse({ description: "Insufficient permissions" })
  @ApiNotFoundResponse({ description: "Record not found" })
  @ApiBearerAuth()
  @Roles("admin")
  @Post(":id/restore")
  @HttpCode(204)
  async restore(
    @Param("id", ParseUUIDPipe) id: string,
    @CurrentUser() user?: AuthUser,
  ): Promise<void> {
    await this.service.restore(id, user);
  }
}
