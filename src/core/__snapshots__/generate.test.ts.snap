    "content": "import "dotenv/config";
import "reflect-metadata";
import { AppModule } from "./app.module";
import { setupSwagger } from "./config/swagger.config";
import { Logger, ValidationPipe } from "@nestjs/common";
import { NestFactory } from "@nestjs/core";

if (process.env.NODE_ENV === "production") {
  const accessSecret = process.env.JWT_ACCESS_SECRET;
  const refreshSecret = process.env.JWT_REFRESH_SECRET;
  if (
    !accessSecret ||
    accessSecret === "change-me-access-secret" ||
    !refreshSecret ||
    refreshSecret === "change-me-refresh-secret"
  ) {
    throw new Error("Refusing to boot in production with default JWT secrets.");
  }
}

async function bootstrap(): Promise<void> {
  const app = await NestFactory.create(AppModule);
  app.setGlobalPrefix("api");
  app.useGlobalPipes(
    new ValidationPipe({
      whitelist: true,
      transform: true,
      transformOptions: { enableImplicitConversion: true },
    }),
  );
  setupSwagger(app, "api", true);
  app.enableShutdownHooks();

  const port = Number(process.env.PORT ?? 3000);
  await app.listen(port);
  Logger.log(\`API listening on http://localhost:\${port}/api\`, "Bootstrap");
}

void bootstrap();
",
    "path": "src/main.ts",
  },
  {
    "content": "import { CurrentUser } from "../../auth/decorators/current-user.decorator";
import { Roles } from "../../auth/decorators/roles.decorator";
import { AuthUser } from "../../auth/interfaces/auth-user.interface";
import { Comment as CommentEntity } from "./comment.entity";
import { CommentService } from "./comment.service";
import { CreateCommentDto } from "./dto/create-comment.dto";
import { PaginatedCommentDto } from "./dto/paginated-comment.dto";
import { QueryCommentDto } from "./dto/query-comment.dto";
import { UpdateCommentDto } from "./dto/update-comment.dto";
import {
  Body,
  Controller,
  Delete,
  Get,
  HttpCode,
  Param,
  ParseUUIDPipe,
  Patch,
  Post,
  Query,
} from "@nestjs/common";
import {
  ApiBadRequestResponse,
  ApiBearerAuth,
  ApiCreatedResponse,
  ApiForbiddenResponse,
  ApiNoContentResponse,
  ApiNotFoundResponse,
  ApiOkResponse,
  ApiOperation,
  ApiTags,
  ApiUnauthorizedResponse,
} from "@nestjs/swagger";

@ApiTags("comments")
@Controller("comments")
export class CommentController {
  constructor(private readonly service: CommentService) {}

  @ApiOperation({ summary: "List Comment records" })
  @ApiOkResponse({ description: "Paginated Comment list", type: PaginatedCommentDto })
  @ApiBadRequestResponse({ description: "Invalid query parameters" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiBearerAuth()
  @Get()
  findAll(@Query() query: QueryCommentDto, @CurrentUser() user?: AuthUser) {
    return this.service.findAll(query, user);
  }

  @ApiOperation({ summary: "Get one Comment" })
  @ApiOkResponse({ description: "Comment found", type: CommentEntity })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiNotFoundResponse({ description: "Record not found" })
  @ApiBearerAuth()
  @Get(":id")
  findOne(@Param("id", ParseUUIDPipe) id: string, @CurrentUser() user?: AuthUser) {
    return this.service.findOne(id, user);
  }

  @ApiOperation({ summary: "Create a Comment" })
  @ApiCreatedResponse({ description: "Comment created", type: CommentEntity })
  @ApiBadRequestResponse({ description: "Validation failed" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiBearerAuth()
  @Post()
  create(@Body() dto: CreateCommentDto, @CurrentUser() user?: AuthUser) {
    return this.service.create(dto, user);
  }

  @ApiOperation({ summary: "Update a Comment" })
  @ApiOkResponse({ description: "Comment updated", type: CommentEntity })
  @ApiBadRequestResponse({ description: "Validation failed" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiForbiddenResponse({ description: "Insufficient permissions" })
  @ApiNotFoundResponse({ description: "Record not found" })
  @ApiBearerAuth()
  // Admin bypass and owner scoping are enforced by the service query.
  @Patch(":id")
  update(
    @Param("id", ParseUUIDPipe) id: string,
    @Body() dto: UpdateCommentDto,
    @CurrentUser() user?: AuthUser,
  ) {
    return this.service.update(id, dto, user);
  }

  @ApiOperation({ summary: "Delete a Comment" })
  @ApiNoContentResponse({ description: "Comment deleted" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiForbiddenResponse({ description: "Insufficient permissions" })
  @ApiNotFoundResponse({ description: "Record not found" })
  @ApiBearerAuth()
  @Roles("admin")
  @Delete(":id")
  @HttpCode(204)
  async remove(
    @Param("id", ParseUUIDPipe) id: string,
    @CurrentUser() user?: AuthUser,
  ): Promise<void> {
    await this.service.remove(id, user);
  }
}
