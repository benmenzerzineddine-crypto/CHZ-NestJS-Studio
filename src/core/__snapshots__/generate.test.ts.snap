    "content": "import { PostStatus } from "../../../common/enums";
import { ApiProperty, ApiPropertyOptional } from "@nestjs/swagger";
import {
  IsArray,
  IsDateString,
  IsEnum,
  IsInt,
  IsOptional,
  IsString,
  IsUUID,
  MaxLength,
  Min,
  MinLength,
} from "class-validator";

export class CreatePostDto {
  @ApiProperty({ type: String, example: "Hello world" })
  @IsString()
  @MaxLength(160)
  @MinLength(3)
  title: string;

  @ApiProperty({ type: String, example: "hello-world" })
  @IsString()
  @MaxLength(180)
  slug: string;

  @ApiProperty({ type: String, example: "sample text" })
  @IsString()
  @MinLength(1)
  content: string;

  @ApiProperty({ enum: PostStatus, example: "draft" })
  @IsEnum(PostStatus)
  status: PostStatus;

  @ApiPropertyOptional({ type: String, format: "date-time", example: "2024-01-01T00:00:00.000Z" })
  @IsOptional()
  @IsDateString()
  publishedAt?: string | null;

  @ApiPropertyOptional({ type: Number, example: 0 })
  @IsOptional()
  @IsInt()
  @Min(0)
  views?: number;

  @ApiProperty({ type: String, format: "uuid", example: "00000000-0000-4000-8000-000000000000" })
  @IsUUID()
  authorId: string;

  @ApiPropertyOptional({ type: [String] })
  @IsArray()
  @IsUUID(undefined, { each: true })
  @IsOptional()
  tagsIds?: string[];
}
