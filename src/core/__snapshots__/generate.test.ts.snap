    "content": "import type { User } from "../../users/entities/user.entity";
import type { Post } from "../post/post.entity";
import {
  Column,
  CreateDateColumn,
  Entity,
  Index,
  JoinColumn,
  ManyToOne,
  PrimaryGeneratedColumn,
  UpdateDateColumn,
} from "typeorm";

@Entity("comments")
export class Comment {
  @PrimaryGeneratedColumn("uuid", { name: "id" })
  id: string;

  @Column({ type: "text", name: "body", nullable: false })
  body: string;

  @Column({ type: "boolean", name: "is_approved", nullable: false, default: false })
  isApproved: boolean;

  @CreateDateColumn({ name: "created_at", type: "datetime" })
  createdAt: Date;

  @UpdateDateColumn({ name: "updated_at", type: "datetime" })
  updatedAt: Date;

  @Index()
  @Column({ name: "post_id", type: "varchar", length: 36, nullable: false })
  postId: string;

  @ManyToOne("Post", { nullable: false, onDelete: "CASCADE" })
  @JoinColumn({ name: "post_id", referencedColumnName: "id" })
  post: Post;

  @Index()
  @Column({ name: "owner_id", type: "varchar", length: 36, nullable: true })
  ownerId?: string;

  @ManyToOne("User", { nullable: true, onDelete: "CASCADE" })
  @JoinColumn({ name: "owner_id", referencedColumnName: "id" })
  owner?: User | null;
}
