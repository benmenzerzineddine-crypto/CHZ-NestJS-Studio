  {
    "content": "import { PaginationQueryDto } from "../../../common/dto/pagination-query.dto";
import { PostStatus } from "../../../common/enums";
import { ApiPropertyOptional } from "@nestjs/swagger";
import { Type } from "class-transformer";
import { IsDateString, IsIn, IsInt, IsOptional, IsString } from "class-validator";

export class QueryPostDto extends PaginationQueryDto {
  @ApiPropertyOptional({ type: String, example: "Hello world" })
  @IsString()
  @IsOptional()
  title?: string;

  @ApiPropertyOptional({ type: String, example: "hello-world" })
  @IsString()
  @IsOptional()
  slug?: string;

  @ApiPropertyOptional({ type: String, example: "sample text" })
  @IsString()
  @IsOptional()
  content?: string;

  @ApiPropertyOptional({ enum: PostStatus, example: "draft" })
  @IsIn(["draft", "published", "archived"])
  @IsOptional()
  status?: string;

  @ApiPropertyOptional({ type: String, format: "date-time", example: "2024-01-01T00:00:00.000Z" })
  @IsDateString()
  @IsOptional()
  publishedAt?: string;

  @ApiPropertyOptional({ type: String, format: "date-time", example: "2024-01-01T00:00:00.000Z" })
  @IsDateString()
  @IsOptional()
  publishedAtGte?: string;

  @ApiPropertyOptional({ type: String, format: "date-time", example: "2024-01-01T00:00:00.000Z" })
  @IsDateString()
  @IsOptional()
  publishedAtLte?: string;

  @ApiPropertyOptional({ type: Number, example: 0 })
  @Type(() => Number)
  @IsInt()
  @IsOptional()
  views?: number;

  @ApiPropertyOptional({ type: Number, example: 0 })
  @Type(() => Number)
  @IsInt()
  @IsOptional()
  viewsGte?: number;

  @ApiPropertyOptional({ type: Number, example: 0 })
  @Type(() => Number)
  @IsInt()
  @IsOptional()
  viewsLte?: number;
}
