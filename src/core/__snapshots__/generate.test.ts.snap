      .get("/api/posts?limit=101")
      .set(authHeader(null));
    expect(badLimit.status).toBe(400);
    const badSort = await request(app.getHttpServer())
      .get("/api/posts?sort=__not_a_field__")
      .set(authHeader(null));
    expect(badSort.status).toBe(400);
