  {
    "content": "import "dotenv/config";
import "reflect-metadata";
import { PostStatus } from "../../common/enums";
import { Comment } from "../../modules/comment/comment.entity";
import { Post } from "../../modules/post/post.entity";
import { Tag } from "../../modules/tag/tag.entity";
import { User } from "../../users/entities/user.entity";
import baseDataSource from "../data-source";
import { hash } from "bcrypt";
import { DataSource } from "typeorm";
import type { QueryDeepPartialEntity } from "typeorm";

const ADMIN_ROLE = "admin";
const SEED_ADMIN = true && process.env.SEED_ADMIN !== "false";
const ADMIN_EMAIL = process.env.ADMIN_EMAIL ?? "admin@example.com";
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD ?? "change-me-admin-password";
const RESET = process.argv.includes("--reset");

async function seed(): Promise<void> {
  if (RESET && process.env.NODE_ENV === "production") {
    throw new Error("--reset is not allowed in production.");
  }

  const synchronize =
    process.env.DB_SYNCHRONIZE === "true" ||
    (process.env.DB_SYNCHRONIZE !== "false" && process.env.NODE_ENV !== "production");
  const dataSource = new DataSource({ ...baseDataSource.options, synchronize });
  await dataSource.initialize();

  try {
    if (RESET) {
      const tables = ["posts_tags", "comments", "tags", "posts"];
      for (const table of tables) {
        await dataSource.createQueryBuilder().delete().from(table).execute();
      }
      console.log(\`Reset \${tables.length} tables.\`);
    }

    const users = dataSource.getRepository(User);
    if (SEED_ADMIN) {
      const existing = await users.findOne({ where: { email: ADMIN_EMAIL } });
      if (!existing) {
        await users.save(
          users.create({
            email: ADMIN_EMAIL,
            passwordHash: await hash(ADMIN_PASSWORD, 12),
            roles: [ADMIN_ROLE],
            isActive: true,
          }),
        );
        console.log(\`Created admin \${ADMIN_EMAIL}.\`);
      } else {
        console.log(\`Admin \${ADMIN_EMAIL} already exists.\`);
      }
    }

    const admin = await users.findOne({ where: { email: ADMIN_EMAIL } });
    const adminId = admin?.id;
    if (!adminId) {
      throw new Error(
        "Seed data needs the admin user. Set SEED_ADMIN=true or create ADMIN_EMAIL first.",
      );
    }

    const postRows: Array<Record<string, unknown>> = [
      {
        id: "00000000-0000-4000-8000-000000001001",
        title: "Post sample 1",
        slug: "Post 1",
        content: "Post sample 1",
        status: PostStatus.Draft,
        publishedAt: new Date("2024-01-01T00:00:00.000Z"),
        views: 0,
        authorId: adminId,
      },
      {
        id: "00000000-0000-4000-8000-000000001002",
        title: "Post sample 2",
        slug: "Post 2",
        content: "Post sample 2",
        status: PostStatus.Published,
        publishedAt: new Date("2024-01-02T00:00:00.000Z"),
        views: 1,
        authorId: adminId,
      },
      {
        id: "00000000-0000-4000-8000-000000001003",
        title: "Post sample 3",
        slug: "Post 3",
        content: "Post sample 3",
        status: PostStatus.Archived,
        publishedAt: new Date("2024-01-03T00:00:00.000Z"),
        views: 2,
        authorId: adminId,
      },
    ];
    await dataSource.getRepository(Post).upsert(postRows as QueryDeepPartialEntity<Post>[], ["id"]);

    const tagRows: Array<Record<string, unknown>> = [
      {
        id: "00000000-0000-4000-8000-000000001011",
        name: "Tag 1",
      },
      {
        id: "00000000-0000-4000-8000-000000001012",
        name: "Tag 2",
      },
      {
        id: "00000000-0000-4000-8000-000000001013",
        name: "Tag 3",
      },
    ];
    await dataSource.getRepository(Tag).upsert(tagRows as QueryDeepPartialEntity<Tag>[], ["id"]);

    const commentRows: Array<Record<string, unknown>> = [
      {
        id: "00000000-0000-4000-8000-000000001021",
        body: "Comment sample 1",
        isApproved: true,
        postId: "00000000-0000-4000-8000-000000001001",
      },
      {
        id: "00000000-0000-4000-8000-000000001022",
        body: "Comment sample 2",
        isApproved: false,
        postId: "00000000-0000-4000-8000-000000001002",
      },
      {
        id: "00000000-0000-4000-8000-000000001023",
        body: "Comment sample 3",
        isApproved: true,
        postId: "00000000-0000-4000-8000-000000001003",
      },
    ];
    await dataSource
      .getRepository(Comment)
      .upsert(commentRows as QueryDeepPartialEntity<Comment>[], ["id"]);

    await dataSource
      .createQueryBuilder()
      .insert()
      .into("posts_tags")
      .values([
        {
          post_id: "00000000-0000-4000-8000-000000001001",
          tag_id: "00000000-0000-4000-8000-000000001011",
        },
        {
          post_id: "00000000-0000-4000-8000-000000001002",
          tag_id: "00000000-0000-4000-8000-000000001012",
        },
        {
          post_id: "00000000-0000-4000-8000-000000001003",
          tag_id: "00000000-0000-4000-8000-000000001013",
        },
      ])
      .orIgnore()
      .execute();

    console.log("Seed complete.");
  } finally {
    await dataSource.destroy();
  }
}

seed().catch((error: unknown) => {
  console.error(error);
  process.exitCode = 1;
});
",
    "path": "src/database/seeds/seed.ts",
  },
