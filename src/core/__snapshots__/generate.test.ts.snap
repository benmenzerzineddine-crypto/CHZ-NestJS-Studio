  {
    "content": "import type { ConfigService } from "@nestjs/config";
import type { TypeOrmModuleOptions } from "@nestjs/typeorm";
import { join } from "node:path";

function resolveDbType(value: string | undefined): "postgres" | "mysql" | "sqlite" {
  const type = value ?? "postgres";
  if (type !== "postgres" && type !== "mysql" && type !== "sqlite") {
    throw new Error(\`Unsupported DB_TYPE: \${type}\`);
  }
  return type;
}

export function buildTypeOrmOptions(config: ConfigService): TypeOrmModuleOptions {
  const type = resolveDbType(config.get<string>("DB_TYPE") ?? "sqlite");
  const entities = [join(__dirname, "..", "**", "*.entity{.ts,.js}")];
  const synchronize =
    config.get<string>("DB_SYNCHRONIZE") === "true" ||
    (config.get<string>("DB_SYNCHRONIZE") !== "false" &&
      config.get<string>("NODE_ENV") !== "production");
  const dropSchema = config.get<string>("NODE_ENV") === "test";
  const logging = config.get<string>("DB_LOGGING") === "true";

  if (type === "sqlite") {
    return {
      type: "better-sqlite3",
      database: config.get<string>("DB_DATABASE") ?? "app.sqlite",
      entities,
      synchronize,
      dropSchema,
      logging,
    };
  }

  if (type === "mysql") {
    return {
      type,
      host: config.get<string>("DB_HOST") ?? "localhost",
      port: Number(config.get<string>("DB_PORT") ?? 3306),
      username: config.get<string>("DB_USERNAME") ?? "root",
      password: config.get<string>("DB_PASSWORD") ?? "",
      database: config.get<string>("DB_DATABASE") ?? "blog-api",
      entities,
      synchronize,
      dropSchema,
      logging,
    };
  }

  return {
    type,
    host: config.get<string>("DB_HOST") ?? "localhost",
    port: Number(config.get<string>("DB_PORT") ?? 5432),
    username: config.get<string>("DB_USERNAME") ?? "postgres",
    password: config.get<string>("DB_PASSWORD") ?? "",
    database: config.get<string>("DB_DATABASE") ?? "blog-api",
    entities,
    synchronize,
    dropSchema,
    logging,
  };
}
",
