    "content": "import { CurrentUser } from "../auth/decorators/current-user.decorator";
import { Roles } from "../auth/decorators/roles.decorator";
import { AuthUser } from "../auth/interfaces/auth-user.interface";
import { ChangePasswordDto } from "./dto/change-password.dto";
import { QueryUserDto } from "./dto/query-user.dto";
import { UpdateProfileDto } from "./dto/update-profile.dto";
import { UpdateRolesDto } from "./dto/update-roles.dto";
import { UsersService } from "./users.service";
import {
  Body,
  Controller,
  Delete,
  Get,
  HttpCode,
  Param,
  ParseUUIDPipe,
  Patch,
  Post,
  Query,
} from "@nestjs/common";
import { ApiBearerAuth, ApiTags } from "@nestjs/swagger";

@ApiTags("users")
@ApiBearerAuth()
@Controller("users")
export class UsersController {
  constructor(private readonly usersService: UsersService) {}

  @Roles("admin")
  @Get()
  findAll(@Query() query: QueryUserDto) {
    return this.usersService.list(query);
  }

  @Roles("admin")
  @Patch(":id/roles")
  updateRoles(
    @Param("id", ParseUUIDPipe) id: string,
    @Body() dto: UpdateRolesDto,
    @CurrentUser() actor: AuthUser,
  ) {
    return this.usersService.updateRoles(id, dto.roles, actor.id);
  }

  @Roles("admin")
  @Delete(":id")
  @HttpCode(204)
  async remove(
    @Param("id", ParseUUIDPipe) id: string,
    @CurrentUser() actor: AuthUser,
  ): Promise<void> {
    await this.usersService.remove(id, actor.id);
  }

  @Post("change-password")
  @HttpCode(200)
  changePassword(@Body() dto: ChangePasswordDto, @CurrentUser() actor: AuthUser) {
    return this.usersService.changePassword(actor.id, dto.currentPassword, dto.newPassword);
  }

  @Patch("me")
  updateProfile(@Body() dto: UpdateProfileDto, @CurrentUser() actor: AuthUser) {
    return this.usersService.updateProfile(actor.id, dto);
  }
}
",
    "path": "src/users/users.controller.ts",
  },
  {
    "content": "import { RefreshToken } from "./entities/refresh-token.entity";
import { User } from "./entities/user.entity";
import { UsersController } from "./users.controller";
import { UsersService } from "./users.service";
import { Module } from "@nestjs/common";
import { TypeOrmModule } from "@nestjs/typeorm";

@Module({
  imports: [TypeOrmModule.forFeature([User, RefreshToken])],
  controllers: [UsersController],
  providers: [UsersService],
  exports: [UsersService],
})
export class UsersModule {}
",
    "path": "src/users/users.module.ts",
  },
  {
    "content": "import { PaginatedResponse } from "../common/interfaces/paginated-response.interface";
import { QueryUserDto } from "./dto/query-user.dto";
import { UpdateProfileDto } from "./dto/update-profile.dto";
import { RefreshToken } from "./entities/refresh-token.entity";
import { User } from "./entities/user.entity";
import {
  BadRequestException,
  ConflictException,
  Injectable,
  NotFoundException,
} from "@nestjs/common";
import { InjectRepository } from "@nestjs/typeorm";
import { compare, hash } from "bcrypt";
import { Repository } from "typeorm";

const ALLOWED_ROLES = ["admin", "user", "editor"];
const DEFAULT_ROLE = "user";
const ADMIN_ROLE = "admin";

@Injectable()
export class UsersService {
  constructor(
    @InjectRepository(User) private readonly users: Repository<User>,
    @InjectRepository(RefreshToken) private readonly refreshTokens: Repository<RefreshToken>,
  ) {}

  async list(query: QueryUserDto): Promise<PaginatedResponse<User>> {
    const qb = this.users.createQueryBuilder("user").where("user.deletedAt IS NULL");
    if (query.email) {
      qb.andWhere("user.email ILIKE :email", { email: \`%\${query.email}%\` });
    }
    if (query.search) {
      qb.andWhere("user.email ILIKE :search", { search: \`%\${query.search}%\` });
    }

    qb.orderBy("user.createdAt", "DESC");
    const page = query.page ?? 1;
    const limit = query.limit ?? 20;
    qb.skip((page - 1) * limit).take(limit);
    const [data, total] = await qb.getManyAndCount();
    return { data, meta: { page, limit, total, totalPages: Math.ceil(total / limit) } };
  }

  async findById(id: string, withPassword = false): Promise<User | null> {
    const qb = this.users
      .createQueryBuilder("user")
      .where("user.id = :id", { id })
      .andWhere("user.deletedAt IS NULL");
    if (withPassword) qb.addSelect("user.passwordHash");
    return qb.getOne();
  }

  async findByEmail(email: string, withPassword = false): Promise<User | null> {
    const qb = this.users
      .createQueryBuilder("user")
      .where("user.email = :email", { email })
      .andWhere("user.deletedAt IS NULL");
    if (withPassword) qb.addSelect("user.passwordHash");
    return qb.getOne();
  }

  async create(email: string, password: string, roles: string[] = [DEFAULT_ROLE]): Promise<User> {
    const existing = await this.findByEmail(email);
    if (existing) throw new ConflictException("Email already registered");

    const invalid = roles.filter((role) => !ALLOWED_ROLES.includes(role));
    if (invalid.length > 0) throw new BadRequestException(\`Unknown roles: \${invalid.join(", ")}\`);

    const passwordHash = await hash(password, 12);
    const user = this.users.create({ email, passwordHash, roles, isActive: true });
    return this.users.save(user);
  }

  async checkPassword(user: User, password: string): Promise<boolean> {
    if (!user.passwordHash) return false;
    return compare(password, user.passwordHash);
  }

  async updateRoles(id: string, roles: string[], actorId: string): Promise<User> {
    if (id === actorId) throw new BadRequestException("You cannot change your own roles");
    const user = await this.findById(id);
    if (!user) throw new NotFoundException("User not found");

    const invalid = roles.filter((role) => !ALLOWED_ROLES.includes(role));
    if (invalid.length > 0) throw new BadRequestException(\`Unknown roles: \${invalid.join(", ")}\`);

    if (
      user.roles.includes(ADMIN_ROLE) &&
      !roles.includes(ADMIN_ROLE) &&
      (await this.countAdmins()) <= 1
    ) {
      throw new BadRequestException("The last admin cannot be demoted");
    }

    user.roles = roles;
    return this.users.save(user);
  }

  async changePassword(
    userId: string,
    currentPassword: string,
    newPassword: string,
  ): Promise<{ success: boolean }> {
    const user = await this.findById(userId, true);
    if (!user) throw new NotFoundException("User not found");
    if (!(await this.checkPassword(user, currentPassword))) {
      throw new BadRequestException("Current password is incorrect");
    }

    user.passwordHash = await hash(newPassword, 12);
    await this.users.save(user);
    await this.refreshTokens
      .createQueryBuilder()
      .update()
      .set({ revokedAt: new Date() })
      .where("userId = :userId", { userId })
      .andWhere("revokedAt IS NULL")
      .execute();
    return { success: true };
  }

  async updateProfile(id: string, dto: UpdateProfileDto): Promise<User> {
    const user = await this.findById(id);
    if (!user) throw new NotFoundException("User not found");

    if (dto.email !== undefined && dto.email !== user.email) {
      const existing = await this.findByEmail(dto.email);
      if (existing && existing.id !== user.id)
        throw new ConflictException("Email already registered");
    }

    if (dto.email !== undefined) user.email = dto.email;

    return this.users.save(user);
  }

  async remove(id: string, actorId: string): Promise<void> {
    if (id === actorId) throw new BadRequestException("You cannot delete your own account");
    const user = await this.findById(id);
    if (!user) throw new NotFoundException("User not found");
    if (user.roles.includes(ADMIN_ROLE) && (await this.countAdmins()) <= 1) {
      throw new BadRequestException("The last admin cannot be deleted");
    }
    await this.users.softRemove(user);
  }

  private async countAdmins(): Promise<number> {
    return this.users
      .createQueryBuilder("user")
      .where("user.deletedAt IS NULL")
      .andWhere(
        "(user.roles = :admin OR user.roles LIKE :prefix OR user.roles LIKE :suffix OR user.roles LIKE :middle)",
        {
          admin: ADMIN_ROLE,
          prefix: \`\${ADMIN_ROLE},%\`,
          suffix: \`%,\${ADMIN_ROLE}\`,
          middle: \`%,\${ADMIN_ROLE},%\`,
        },
      )
      .getCount();
  }
}
",
    "path": "src/users/users.service.ts",
  },
  {
    "content": "import { INestApplication } from "@nestjs/common";
import { JwtService } from "@nestjs/jwt";
import { randomUUID } from "node:crypto";
import request from "supertest";
import { DataSource } from "typeorm";
import { User } from "../src/users/entities/user.entity";
import { AuthService } from "../src/auth/auth.service";
import { TEST_PASSWORD, authHeader, createTestApp, createUser } from "./utils/auth";

jest.setTimeout(30_000);

interface AuthResponse {
  accessToken: string;
  refreshToken?: string;
  user: User;
}

describe("authentication", () => {
  let app: INestApplication;
  let user: User;
  let tokens: AuthResponse;

  beforeAll(async () => {
    app = await createTestApp();
    user = await createUser(app, ["user"]);
    const response = await request(app.getHttpServer()).post("/api/auth/login").send({
      email: user.email,
      password: TEST_PASSWORD,
    });
    expect(response.status).toBe(200);
    tokens = response.body as AuthResponse;
  });

  afterAll(async () => {
    await app.close();
  });

  it("logs in with valid credentials", () => {
    expect(tokens.accessToken).toBeTruthy();
    expect(tokens.user.email).toBe(user.email);
    expect(tokens.user.passwordHash).toBeUndefined();
  });

  it("rejects invalid credentials", async () => {
    const response = await request(app.getHttpServer()).post("/api/auth/login").send({
      email: user.email,
      password: "definitely-wrong",
    });
    expect(response.status).toBe(401);
  });

  it("rejects missing, expired and invalid access tokens", async () => {
    const missing = await request(app.getHttpServer()).get("/api/auth/me");
    expect(missing.status).toBe(401);
    const invalid = await request(app.getHttpServer())
      .get("/api/auth/me")
      .set(authHeader("not-a-token"));
    expect(invalid.status).toBe(401);
    const jwt = app.get(JwtService);
    const expired = await jwt.signAsync(
      { sub: user.id, email: user.email, roles: user.roles },
      { expiresIn: -1 },
    );
    const expiredResponse = await request(app.getHttpServer())
      .get("/api/auth/me")
      .set(authHeader(expired));
    expect(expiredResponse.status).toBe(401);
  });

  it("returns the current user", async () => {
    const response = await request(app.getHttpServer())
      .get("/api/auth/me")
      .set(authHeader(tokens.accessToken));
    expect(response.status).toBe(200);
    expect(response.body.email).toBe(user.email);
    expect(response.body.passwordHash).toBeUndefined();
  });

  it("registers a new user", async () => {
    const email = \`registered-\${randomUUID()}@example.com\`;
    const response = await request(app.getHttpServer()).post("/api/auth/register").send({
      email,
      password: TEST_PASSWORD,
    });
    expect(response.status).toBe(201);
    expect(response.body.accessToken).toBeTruthy();
    expect(response.body.user.email).toBe(email);
    expect(response.body.user.passwordHash).toBeUndefined();

    const duplicate = await request(app.getHttpServer()).post("/api/auth/register").send({
      email,
      password: TEST_PASSWORD,
    });
    expect(duplicate.status).toBe(409);
  });

  it("rotates refresh tokens and revokes them on logout", async () => {
    expect(tokens.refreshToken).toBeTruthy();
    const refreshed = await request(app.getHttpServer())
      .post("/api/auth/refresh")
      .send({ refreshToken: tokens.refreshToken });
    expect(refreshed.status).toBe(200);
    const next = refreshed.body as AuthResponse;
    expect(next.refreshToken).toBeTruthy();
    expect(next.refreshToken).not.toBe(tokens.refreshToken);

    const reused = await request(app.getHttpServer())
      .post("/api/auth/refresh")
      .send({ refreshToken: tokens.refreshToken });
    expect(reused.status).toBe(401);

    const jwt = app.get(JwtService);
    const expired = await jwt.signAsync(
      { sub: user.id, email: user.email, roles: user.roles },
      { expiresIn: -1 },
    );
    const logout = await request(app.getHttpServer())
      .post("/api/auth/logout")
      .set(authHeader(expired))
      .send({ refreshToken: next.refreshToken });
    expect(logout.status).toBe(200);
    const afterLogout = await request(app.getHttpServer())
      .post("/api/auth/refresh")
      .send({ refreshToken: next.refreshToken });
    expect(afterLogout.status).toBe(401);
  });

  it("rejects inactive users on login and refresh", async () => {
    const inactive = await createUser(app, ["user"]);
    const auth = app.get(AuthService);
    const loggedIn = await auth.login({ email: inactive.email, password: TEST_PASSWORD });
    const dataSource = app.get(DataSource);
    await dataSource.getRepository(User).update(inactive.id, { isActive: false });
    const loginResponse = await request(app.getHttpServer()).post("/api/auth/login").send({
      email: inactive.email,
      password: TEST_PASSWORD,
    });
    expect(loginResponse.status).toBe(401);
    const response = await request(app.getHttpServer()).post("/api/auth/refresh").send({
      refreshToken: loggedIn.refreshToken,
    });
    expect(response.status).toBe(401);
  });

  it("changes the current password", async () => {
    const auth = app.get(AuthService);
    const beforeChange = await auth.login({ email: user.email, password: TEST_PASSWORD });
    expect(beforeChange.refreshToken).toBeTruthy();
    const changed = await request(app.getHttpServer())
      .post("/api/users/change-password")
      .set(authHeader(tokens.accessToken))
      .send({
        currentPassword: TEST_PASSWORD,
        newPassword: "NewPassword123!",
      });
    expect(changed.status).toBe(200);
    const staleRefresh = await request(app.getHttpServer())
      .post("/api/auth/refresh")
      .send({ refreshToken: beforeChange.refreshToken });
    expect(staleRefresh.status).toBe(401);

    const oldLogin = await request(app.getHttpServer()).post("/api/auth/login").send({
      email: user.email,
      password: TEST_PASSWORD,
    });
    expect(oldLogin.status).toBe(401);

    const newLogin = await request(app.getHttpServer()).post("/api/auth/login").send({
      email: user.email,
      password: "NewPassword123!",
    });
    expect(newLogin.status).toBe(200);
  });
});
",
    "path": "test/auth.e2e-spec.ts",
  },
  {
    "content": "import { INestApplication } from "@nestjs/common";
import { randomUUID } from "node:crypto";
import request from "supertest";
import { DataSource } from "typeorm";
import { User } from "../src/users/entities/user.entity";
import { Post } from "../src/modules/post/post.entity";
import { Tag } from "../src/modules/tag/tag.entity";
import { Comment } from "../src/modules/comment/comment.entity";
import { authHeader, createTestApp, createUser, login } from "./utils/auth";
import { listItems, unique } from "./utils/db";
import { createFactories } from "./utils/factories";
import { UsersService } from "../src/users/users.service";

jest.setTimeout(30_000);

describe("authorization", () => {
  let app: INestApplication;
  let dataSource: DataSource;
  let admin: User;
  let owner: User;
  let other: User;
  let creator: User;
  let adminToken: string;
  let ownerToken: string;
  let otherToken: string;
  let creatorToken: string;
  let factory: ReturnType<typeof createFactories>;

  beforeAll(async () => {
    app = await createTestApp();
    dataSource = app.get(DataSource);
    admin = await createUser(app, ["admin"]);
    owner = await createUser(app, ["user"]);
    other = await createUser(app, ["user"]);
    creator = await createUser(app, ["admin", "user", "editor"]);
    adminToken = await login(app, admin.email);
    ownerToken = await login(app, owner.email);
    otherToken = await login(app, other.email);
    creatorToken = await login(app, creator.email);
    factory = createFactories({
      app,
      dataSource,
      tokens: {
        admin: adminToken,
        owner: ownerToken,
        other: otherToken,
        creator: creatorToken,
      },
      ownerId: owner.id,
    });
  });

  afterAll(async () => {
    await app.close();
  });

  describe("Post", () => {
    let sample: Post;

    beforeAll(async () => {
      sample = await factory.makePost(unique("post"));
    });

    it("allows anonymous list", async () => {
      const response = await request(app.getHttpServer()).get("/api/posts");
      expect(response.status).toBe(200);
    });

    it("allows anonymous read", async () => {
      const response = await request(app.getHttpServer()).get(\`/api/posts/\${sample.id}\`);
      expect(response.status).toBe(200);
    });

    it("rejects anonymous create", async () => {
      const response = await request(app.getHttpServer()).post("/api/posts").send({});
      expect(response.status).toBe(401);
    });

    it("rejects anonymous update", async () => {
      const response = await request(app.getHttpServer()).patch(\`/api/posts/\${sample.id}\`).send({});
      expect(response.status).toBe(401);
    });

    it("rejects anonymous delete", async () => {
      const response = await request(app.getHttpServer()).delete(\`/api/posts/\${sample.id}\`);
      expect(response.status).toBe(401);
    });

    it("rejects delete without a required role", async () => {
      const response = await request(app.getHttpServer())
        .delete(\`/api/posts/\${sample.id}\`)
        .set(authHeader(otherToken));
      expect(response.status).toBe(403);
    });

    it("protects owner updates", async () => {
      const ownerResponse = await request(app.getHttpServer())
        .patch(\`/api/posts/\${sample.id}\`)
        .set(authHeader(ownerToken))
        .send({});
      expect(ownerResponse.status).toBe(200);
      const otherResponse = await request(app.getHttpServer())
        .patch(\`/api/posts/\${sample.id}\`)
        .set(authHeader(otherToken))
        .send({});
      expect(otherResponse.status).toBe(404);
      const adminResponse = await request(app.getHttpServer())
        .patch(\`/api/posts/\${sample.id}\`)
        .set(authHeader(adminToken))
        .send({});
      expect(adminResponse.status).toBe(200);
    });

    it("clears the nullable publishedAt date", async () => {
      const setDate = await request(app.getHttpServer())
        .patch(\`/api/posts/\${sample.id}\`)
        .set(authHeader(ownerToken))
        .send({ publishedAt: "2024-02-02T00:00:00.000Z" });
      expect(setDate.status).toBe(200);
      expect(setDate.body.publishedAt).toBeTruthy();

      const cleared = await request(app.getHttpServer())
        .patch(\`/api/posts/\${sample.id}\`)
        .set(authHeader(ownerToken))
        .send({ publishedAt: null });
      expect(cleared.status).toBe(200);
      expect(cleared.body.publishedAt).toBeNull();
    });
  });

  describe("Tag", () => {
    let sample: Tag;

    beforeAll(async () => {
      sample = await factory.makeTag(unique("tag"));
    });

    it("allows anonymous list", async () => {
      const response = await request(app.getHttpServer()).get("/api/tags");
      expect(response.status).toBe(200);
    });

    it("allows anonymous read", async () => {
      const response = await request(app.getHttpServer()).get(\`/api/tags/\${sample.id}\`);
      expect(response.status).toBe(200);
    });

    it("rejects anonymous create", async () => {
      const response = await request(app.getHttpServer()).post("/api/tags").send({});
      expect(response.status).toBe(401);
    });

    it("rejects anonymous update", async () => {
      const response = await request(app.getHttpServer()).patch(\`/api/tags/\${sample.id}\`).send({});
      expect(response.status).toBe(401);
    });

    it("rejects anonymous delete", async () => {
      const response = await request(app.getHttpServer()).delete(\`/api/tags/\${sample.id}\`);
      expect(response.status).toBe(401);
    });

    it("rejects create without a required role", async () => {
      const response = await request(app.getHttpServer())
        .post("/api/tags")
        .set(authHeader(otherToken))
        .send({});
      expect(response.status).toBe(403);
    });

    it("rejects update without a required role", async () => {
      const response = await request(app.getHttpServer())
        .patch(\`/api/tags/\${sample.id}\`)
        .set(authHeader(otherToken))
        .send({});
      expect(response.status).toBe(403);
    });

    it("rejects delete without a required role", async () => {
      const response = await request(app.getHttpServer())
        .delete(\`/api/tags/\${sample.id}\`)
        .set(authHeader(otherToken));
      expect(response.status).toBe(403);
    });
  });

  describe("Comment", () => {
    let sample: Comment;

    beforeAll(async () => {
      sample = await factory.makeComment(unique("comment"));
    });

    it("rejects anonymous list", async () => {
      const response = await request(app.getHttpServer()).get("/api/comments");
      expect(response.status).toBe(401);
    });

    it("rejects anonymous read", async () => {
      const response = await request(app.getHttpServer()).get(\`/api/comments/\${sample.id}\`);
      expect(response.status).toBe(401);
    });

    it("rejects anonymous create", async () => {
      const response = await request(app.getHttpServer()).post("/api/comments").send({});
      expect(response.status).toBe(401);
    });

    it("rejects anonymous update", async () => {
      const response = await request(app.getHttpServer())
        .patch(\`/api/comments/\${sample.id}\`)
        .send({});
      expect(response.status).toBe(401);
    });

    it("rejects anonymous delete", async () => {
      const response = await request(app.getHttpServer()).delete(\`/api/comments/\${sample.id}\`);
      expect(response.status).toBe(401);
    });

    it("rejects delete without a required role", async () => {
      const response = await request(app.getHttpServer())
        .delete(\`/api/comments/\${sample.id}\`)
        .set(authHeader(otherToken));
      expect(response.status).toBe(403);
    });

    it("protects owner updates", async () => {
      const ownerResponse = await request(app.getHttpServer())
        .patch(\`/api/comments/\${sample.id}\`)
        .set(authHeader(ownerToken))
        .send({});
      expect(ownerResponse.status).toBe(200);
      const otherResponse = await request(app.getHttpServer())
        .patch(\`/api/comments/\${sample.id}\`)
        .set(authHeader(otherToken))
        .send({});
      expect(otherResponse.status).toBe(404);
      const adminResponse = await request(app.getHttpServer())
        .patch(\`/api/comments/\${sample.id}\`)
        .set(authHeader(adminToken))
        .send({});
      expect(adminResponse.status).toBe(200);
    });
  });

  describe("user account security", () => {
    it("strips roles and password fields from profile updates", async () => {
      const response = await request(app.getHttpServer())
        .patch("/api/users/me")
        .set(authHeader(otherToken))
        .send({
          roles: ["admin"],
          password: "EscalatedPassword123!",
          passwordHash: "forged",
          isActive: false,
        });
      expect(response.status).toBe(200);
      expect(response.body.roles).toEqual(other.roles);
      expect(response.body.isActive).toBe(true);
      expect(response.body.passwordHash).toBeUndefined();
    });

    it("lets a user update their own profile email", async () => {
      const email = \`profile-\${randomUUID()}@example.com\`;
      const response = await request(app.getHttpServer())
        .patch("/api/users/me")
        .set(authHeader(otherToken))
        .send({ email });
      expect(response.status).toBe(200);
      expect(response.body.email).toBe(email);
    });

    it("rejects non-admin user listing", async () => {
      const response = await request(app.getHttpServer())
        .get("/api/users")
        .set(authHeader(otherToken));
      expect(response.status).toBe(403);
    });

    it("lets an admin list users without password hashes", async () => {
      const response = await request(app.getHttpServer())
        .get("/api/users")
        .set(authHeader(adminToken));
      expect(response.status).toBe(200);
      const items = listItems(response.body);
      expect(items.length).toBeGreaterThan(0);
      expect(items[0]["passwordHash"]).toBeUndefined();
    });

    it("rejects role changes by non-admins", async () => {
      const response = await request(app.getHttpServer())
        .patch(\`/api/users/\${other.id}/roles\`)
        .set(authHeader(otherToken))
        .send({ roles: ["user"] });
      expect(response.status).toBe(403);
    });

    it("blocks admins from changing their own roles", async () => {
      const response = await request(app.getHttpServer())
        .patch(\`/api/users/\${admin.id}/roles\`)
        .set(authHeader(adminToken))
        .send({ roles: ["user"] });
      expect(response.status).toBe(400);
    });

    it("blocks admins from deleting themselves", async () => {
      const response = await request(app.getHttpServer())
        .delete(\`/api/users/\${admin.id}\`)
        .set(authHeader(adminToken));
      expect(response.status).toBe(400);
    });
  });

  describe("last admin guard", () => {
    it("refuses to delete or demote the last admin", async () => {
      const last = await createUser(app, ["admin"]);
      const users = app.get(UsersService);
      await dataSource.getRepository(User).update(admin.id, { roles: ["user"] });
      await dataSource.getRepository(User).update(creator.id, { roles: ["user"] });
      await expect(users.remove(last.id, other.id)).rejects.toThrow("last admin");
      await expect(users.updateRoles(last.id, ["user"], other.id)).rejects.toThrow("last admin");
    });
  });
});
