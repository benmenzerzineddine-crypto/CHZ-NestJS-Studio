  {
    "content": "import { AuthUser } from "../../common/access/access-context";
import { PaginatedResponse } from "../../common/interfaces/paginated-response.interface";
import { CreateTagDto } from "./dto/create-tag.dto";
import { QueryTagDto } from "./dto/query-tag.dto";
import { UpdateTagDto } from "./dto/update-tag.dto";
import { Tag } from "./tag.entity";
import { BadRequestException, Injectable, NotFoundException } from "@nestjs/common";
import { InjectRepository } from "@nestjs/typeorm";
import { Repository } from "typeorm";

@Injectable()
export class TagService {
  constructor(@InjectRepository(Tag) private readonly repository: Repository<Tag>) {}

  async findAll(query: QueryTagDto, user?: AuthUser): Promise<PaginatedResponse<Tag>> {
    const qb = this.repository.createQueryBuilder("tag");
    qb.select(["tag.id", "tag.name", "tag.createdAt", "tag.updatedAt"]);
    if (query.name !== undefined) qb.andWhere("tag.name ILIKE :name", { name: \`%\${query.name}%\` });
    if (query.search) {
      qb.andWhere("(tag.name ILIKE :search)", { search: \`%\${query.search}%\` });
    }
    const sortable = new Set<string>(["id", "createdAt", "updatedAt", "name"]);
    const requestedSort = query.sort?.replace(/^[-+]/, "");
    if (requestedSort && !sortable.has(requestedSort)) {
      throw new BadRequestException(\`Invalid sort field: \${requestedSort}\`);
    }
    const sort = requestedSort ?? "name";
    const order = query.sort?.startsWith("-")
      ? "DESC"
      : query.sort?.startsWith("+")
        ? "ASC"
        : query.order === "ASC"
          ? "ASC"
          : "DESC";
    qb.orderBy(\`tag.\${sort}\`, order);

    const page = query.page ?? 1;
    const limit = query.limit ?? 20;
    qb.skip((page - 1) * limit).take(limit);
    const [data, total] = await qb.getManyAndCount();
    return { data, meta: { page, limit, total, totalPages: Math.ceil(total / limit) } };
  }

  async findOne(id: string, user?: AuthUser): Promise<Tag> {
    const qb = this.repository.createQueryBuilder("tag").where("tag.id = :id", { id });
    const entity = await qb.getOne();
    if (!entity) throw new NotFoundException("Tag not found");
    return entity;
  }

  private async findForUpdate(id: string, user?: AuthUser): Promise<Tag> {
    const qb = this.repository.createQueryBuilder("tag").where("tag.id = :id", { id });
    const entity = await qb.getOne();
    if (!entity) throw new NotFoundException("Tag not found");
    return entity;
  }

  private async findForDelete(id: string, user?: AuthUser): Promise<Tag> {
    const qb = this.repository.createQueryBuilder("tag").where("tag.id = :id", { id });
    const entity = await qb.getOne();
    if (!entity) throw new NotFoundException("Tag not found");
    return entity;
  }

  async create(dto: CreateTagDto, user?: AuthUser): Promise<Tag> {
    const entity = this.repository.create();
    entity.name = dto.name;
    return this.repository.save(entity);
  }

  async update(id: string, dto: UpdateTagDto, user?: AuthUser): Promise<Tag> {
    const entity = await this.findForUpdate(id, user);
    if (dto.name !== undefined) entity.name = dto.name;
    return this.repository.save(entity);
  }

  async remove(id: string, user?: AuthUser): Promise<void> {
    const entity = await this.findForDelete(id, user);
    await this.repository.remove(entity);
  }
}
