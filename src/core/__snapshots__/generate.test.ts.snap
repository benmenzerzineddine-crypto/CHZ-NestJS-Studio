import { randomUUID } from "node:crypto";
import request from "supertest";
import { DataSource } from "typeorm";
import { Comment } from "../src/modules/comment/comment.entity";
import { authHeader, createTestApp, createUser, login } from "./utils/auth";
import { listItems, unique } from "./utils/db";
import { createFactories } from "./utils/factories";

jest.setTimeout(30_000);

describe("Comment CRUD", () => {
  let app: INestApplication;
  let dataSource: DataSource;
  let factory: ReturnType<typeof createFactories>;
  let sample: Comment;
  let adminToken = "";
  let ownerToken = "";
  let otherToken = "";
  let creatorToken = "";

  beforeAll(async () => {
    app = await createTestApp();
    dataSource = app.get(DataSource);
    const owner = await createUser(app, ["user"]);
    const other = await createUser(app, ["user"]);
    const admin = await createUser(app, ["admin"]);
    adminToken = await login(app, admin.email);
    ownerToken = await login(app, owner.email);
    otherToken = await login(app, other.email);
    const creator = await createUser(app, ["admin", "user", "editor"]);
    creatorToken = await login(app, creator.email);
    factory = createFactories({
      app,
      dataSource,
      tokens: {
        admin: adminToken,
        owner: ownerToken,
        other: otherToken,
        creator: creatorToken,
      },
      ownerId: owner.id,
    });
    sample = await factory.makeComment(unique("comment"), creatorToken);
  });

  afterAll(async () => {
    await app.close();
  });

  it("creates a Comment", async () => {
    const payload = await factory.buildComment(unique("comment-create"));
    const response = await request(app.getHttpServer())
      .post("/api/comments")
      .set(authHeader(creatorToken))
      .send(payload);
    expect(response.status).toBe(201);
  });

  it("lists Comment records", async () => {
    const response = await request(app.getHttpServer())
      .get("/api/comments")
      .set(authHeader(creatorToken));
    expect(response.status).toBe(200);
    expect(listItems(response.body).some((item) => item["id"] === sample.id)).toBe(true);
  });

  it("paginates Comment records", async () => {
    const response = await request(app.getHttpServer())
      .get("/api/comments?limit=1&page=1")
      .set(authHeader(creatorToken));
    expect(response.status).toBe(200);
    expect(response.body.meta).toMatchObject({ page: 1, limit: 1 });
    expect(response.body.meta.totalPages).toBeGreaterThanOrEqual(1);
  });

  it("rejects invalid Comment list queries", async () => {
    const badLimit = await request(app.getHttpServer())
      .get("/api/comments?limit=101")
      .set(authHeader(creatorToken));
    expect(badLimit.status).toBe(400);
    const badSort = await request(app.getHttpServer())
      .get("/api/comments?sort=__not_a_field__")
      .set(authHeader(creatorToken));
    expect(badSort.status).toBe(400);
  });

  it("filters Comment records", async () => {
    const value = encodeURIComponent(String(sample.body));
    const response = await request(app.getHttpServer())
      .get(\`/api/comments?body=\${value}\`)
      .set(authHeader(creatorToken));
    expect(response.status).toBe(200);
    expect(listItems(response.body).some((item) => item["id"] === sample.id)).toBe(true);
  });

  it("reads a Comment", async () => {
    const response = await request(app.getHttpServer())
      .get(\`/api/comments/\${sample.id}\`)
      .set(authHeader(creatorToken));
    expect(response.status).toBe(200);
    expect(response.body.id).toBe(sample.id);
  });

  it("updates a Comment", async () => {
    const payload = await factory.buildComment(unique("comment-update"));
    const response = await request(app.getHttpServer())
      .patch(\`/api/comments/\${sample.id}\`)
      .set(authHeader(ownerToken))
      .send({ body: payload.body });
    expect(response.status).toBe(200);
  });

  it("deletes and restores a Comment", async () => {
    const row = await factory.makeComment(unique("comment-delete"), creatorToken);
    const removed = await request(app.getHttpServer())
      .delete(\`/api/comments/\${row.id}\`)
      .set(authHeader(creatorToken));
    expect(removed.status).toBe(204);
    const missing = await request(app.getHttpServer())
      .get(\`/api/comments/\${row.id}\`)
      .set(authHeader(creatorToken));
    expect(missing.status).toBe(404);
  });

  it("rejects invalid Comment input", async () => {
    const payload: Record<string, unknown> = {
      body: null,
    };
    const response = await request(app.getHttpServer())
      .post("/api/comments")
      .set(authHeader(creatorToken))
      .send(payload);
    expect(response.status).toBe(400);
  });

  it("returns 404 for a missing Comment", async () => {
    const missingId = randomUUID();
    const response = await request(app.getHttpServer())
      .get(\`/api/comments/\${missingId}\`)
      .set(authHeader(creatorToken));
    expect(response.status).toBe(404);
  });
});
