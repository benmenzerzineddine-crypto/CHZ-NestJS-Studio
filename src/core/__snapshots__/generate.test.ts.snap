  {
    "content": "import { PostController } from "./post.controller";
import { Post } from "./post.entity";
import { PostService } from "./post.service";
import { Module } from "@nestjs/common";
import { TypeOrmModule } from "@nestjs/typeorm";

@Module({
  imports: [TypeOrmModule.forFeature([Post])],
  controllers: [PostController],
  providers: [PostService],
  exports: [PostService],
})
export class PostModule {}
",
    "path": "src/modules/post/post.module.ts",
  },
  {
    "content": "import { applyAccessScope, AuthUser, isAdmin } from "../../common/access/access-context";
import { PaginatedResponse } from "../../common/interfaces/paginated-response.interface";
import { Tag } from "../tag/tag.entity";
import { CreatePostDto } from "./dto/create-post.dto";
import { QueryPostDto } from "./dto/query-post.dto";
import { UpdatePostDto } from "./dto/update-post.dto";
import { Post } from "./post.entity";
import {
  BadRequestException,
  ForbiddenException,
  Injectable,
  NotFoundException,
} from "@nestjs/common";
import { InjectRepository } from "@nestjs/typeorm";
import { DataSource, In, Repository } from "typeorm";

@Injectable()
export class PostService {
  constructor(
    @InjectRepository(Post) private readonly repository: Repository<Post>,
    private readonly dataSource: DataSource,
  ) {}

  async findAll(query: QueryPostDto, user?: AuthUser): Promise<PaginatedResponse<Post>> {
    const qb = this.repository.createQueryBuilder("post");
    qb.select([
      "post.id",
      "post.title",
      "post.slug",
      "post.content",
      "post.status",
      "post.publishedAt",
      "post.views",
      "post.createdAt",
      "post.updatedAt",
      "post.deletedAt",
      "post.authorId",
      "post.ownerId",
    ]);
    if (query.withDeleted) {
      if (!isAdmin(user, "admin"))
        throw new ForbiddenException("Only administrators can include deleted rows");
      qb.withDeleted();
    }
    if (query.title !== undefined)
      qb.andWhere("post.title LIKE :title", { title: \`%\${query.title}%\` });
    if (query.slug !== undefined) qb.andWhere("post.slug LIKE :slug", { slug: \`%\${query.slug}%\` });
    if (query.content !== undefined)
      qb.andWhere("post.content LIKE :content", { content: \`%\${query.content}%\` });
    if (query.status !== undefined) qb.andWhere("post.status = :status", { status: query.status });
    if (query.publishedAt !== undefined)
      qb.andWhere("post.publishedAt = :publishedAt", { publishedAt: query.publishedAt });
    if (query.publishedAtGte !== undefined)
      qb.andWhere("post.publishedAt >= :publishedAtGte", { publishedAtGte: query.publishedAtGte });
    if (query.publishedAtLte !== undefined)
      qb.andWhere("post.publishedAt <= :publishedAtLte", { publishedAtLte: query.publishedAtLte });
    if (query.views !== undefined) qb.andWhere("post.views = :views", { views: query.views });
    if (query.viewsGte !== undefined)
      qb.andWhere("post.views >= :viewsGte", { viewsGte: query.viewsGte });
    if (query.viewsLte !== undefined)
      qb.andWhere("post.views <= :viewsLte", { viewsLte: query.viewsLte });
    if (query.search) {
      qb.andWhere("(post.title LIKE :search OR post.content LIKE :search)", {
        search: \`%\${query.search}%\`,
      });
    }
    const sortable = new Set<string>(["id", "createdAt", "updatedAt", "title", "publishedAt"]);
    const requestedSort = query.sort?.replace(/^[-+]/, "");
    if (requestedSort && !sortable.has(requestedSort)) {
      throw new BadRequestException(\`Invalid sort field: \${requestedSort}\`);
    }
    const sort = requestedSort ?? "title";
    const order = query.sort?.startsWith("-")
      ? "DESC"
      : query.sort?.startsWith("+")
        ? "ASC"
        : query.order === "ASC"
          ? "ASC"
          : "DESC";
    qb.orderBy(\`post.\${sort}\`, order);

    const page = query.page ?? 1;
    const limit = query.limit ?? 20;
    qb.skip((page - 1) * limit).take(limit);
    const [data, total] = await qb.getManyAndCount();
    return { data, meta: { page, limit, total, totalPages: Math.ceil(total / limit) } };
  }

  async findOne(id: string, user?: AuthUser): Promise<Post> {
    const qb = this.repository.createQueryBuilder("post").where("post.id = :id", { id });
    const entity = await qb.getOne();
    if (!entity) throw new NotFoundException("Post not found");
    return entity;
  }

  private async findForUpdate(id: string, user?: AuthUser): Promise<Post> {
    const qb = this.repository.createQueryBuilder("post").where("post.id = :id", { id });
    applyAccessScope(qb, user, "ownerId", "admin");
    const entity = await qb.getOne();
    if (!entity) throw new NotFoundException("Post not found");
    return entity;
  }

  private async findForDelete(id: string, user?: AuthUser): Promise<Post> {
    const qb = this.repository.createQueryBuilder("post").where("post.id = :id", { id });
    const entity = await qb.getOne();
    if (!entity) throw new NotFoundException("Post not found");
    return entity;
  }

  async create(dto: CreatePostDto, user?: AuthUser): Promise<Post> {
    const entity = this.repository.create();
    entity.title = dto.title;
    entity.slug = dto.slug;
    entity.content = dto.content;
    entity.status = dto.status;
    if (dto.publishedAt !== undefined)
      entity.publishedAt = dto.publishedAt === null ? null : new Date(dto.publishedAt);
    if (dto.views !== undefined) entity.views = dto.views;
    entity.authorId = dto.authorId;
    if (user) entity.ownerId = user.id;
    if (dto.tagsIds) {
      entity.tags = await this.dataSource.getRepository(Tag).findBy({ id: In(dto.tagsIds) });
    }
    return this.repository.save(entity);
  }

  async update(id: string, dto: UpdatePostDto, user?: AuthUser): Promise<Post> {
    const entity = await this.findForUpdate(id, user);
    if (dto.title !== undefined) entity.title = dto.title;
    if (dto.slug !== undefined) entity.slug = dto.slug;
    if (dto.content !== undefined) entity.content = dto.content;
    if (dto.status !== undefined) entity.status = dto.status;
    if (dto.publishedAt !== undefined)
      entity.publishedAt = dto.publishedAt === null ? null : new Date(dto.publishedAt);
    if (dto.views !== undefined) entity.views = dto.views;
    if (dto.authorId !== undefined) entity.authorId = dto.authorId;
    if (dto.tagsIds !== undefined) {
      entity.tags = await this.dataSource.getRepository(Tag).findBy({ id: In(dto.tagsIds) });
    }
    return this.repository.save(entity);
  }

  async remove(id: string, user?: AuthUser): Promise<void> {
    const entity = await this.findForDelete(id, user);
    await this.repository.softRemove(entity);
  }

  async restore(id: string, user?: AuthUser): Promise<void> {
    const qb = this.repository
      .createQueryBuilder("post")
      .withDeleted()
      .where("post.id = :id", { id })
      .andWhere("post.deletedAt IS NOT NULL");
    const entity = await qb.getOne();
    if (!entity) throw new NotFoundException("Post not found");
    await this.repository.restore(id);
  }
}
