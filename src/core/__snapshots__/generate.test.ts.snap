  {
    "content": "import { CurrentUser } from "../../auth/decorators/current-user.decorator";
import { Public } from "../../auth/decorators/public.decorator";
import { Roles } from "../../auth/decorators/roles.decorator";
import { AuthUser } from "../../auth/interfaces/auth-user.interface";
import { CreateTagDto } from "./dto/create-tag.dto";
import { PaginatedTagDto } from "./dto/paginated-tag.dto";
import { QueryTagDto } from "./dto/query-tag.dto";
import { UpdateTagDto } from "./dto/update-tag.dto";
import { Tag as TagEntity } from "./tag.entity";
import { TagService } from "./tag.service";
import {
  Body,
  Controller,
  Delete,
  Get,
  HttpCode,
  Param,
  ParseUUIDPipe,
  Patch,
  Post,
  Query,
} from "@nestjs/common";
import {
  ApiBadRequestResponse,
  ApiBearerAuth,
  ApiCreatedResponse,
  ApiForbiddenResponse,
  ApiNoContentResponse,
  ApiNotFoundResponse,
  ApiOkResponse,
  ApiOperation,
  ApiTags,
  ApiUnauthorizedResponse,
} from "@nestjs/swagger";

@ApiTags("tags")
@Controller("tags")
export class TagController {
  constructor(private readonly service: TagService) {}

  @ApiOperation({ summary: "List Tag records" })
  @ApiOkResponse({ description: "Paginated Tag list", type: PaginatedTagDto })
  @ApiBadRequestResponse({ description: "Invalid query parameters" })
  @Public()
  @Get()
  findAll(@Query() query: QueryTagDto, @CurrentUser() user?: AuthUser) {
    return this.service.findAll(query, user);
  }

  @ApiOperation({ summary: "Get one Tag" })
  @ApiOkResponse({ description: "Tag found", type: TagEntity })
  @ApiNotFoundResponse({ description: "Record not found" })
  @Public()
  @Get(":id")
  findOne(@Param("id", ParseUUIDPipe) id: string, @CurrentUser() user?: AuthUser) {
    return this.service.findOne(id, user);
  }

  @ApiOperation({ summary: "Create a Tag" })
  @ApiCreatedResponse({ description: "Tag created", type: TagEntity })
  @ApiBadRequestResponse({ description: "Validation failed" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiForbiddenResponse({ description: "Insufficient permissions" })
  @ApiBearerAuth()
  @Roles("admin", "editor")
  @Post()
  create(@Body() dto: CreateTagDto, @CurrentUser() user?: AuthUser) {
    return this.service.create(dto, user);
  }

  @ApiOperation({ summary: "Update a Tag" })
  @ApiOkResponse({ description: "Tag updated", type: TagEntity })
  @ApiBadRequestResponse({ description: "Validation failed" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiForbiddenResponse({ description: "Insufficient permissions" })
  @ApiNotFoundResponse({ description: "Record not found" })
  @ApiBearerAuth()
  @Roles("admin", "editor")
  @Patch(":id")
  update(
    @Param("id", ParseUUIDPipe) id: string,
    @Body() dto: UpdateTagDto,
    @CurrentUser() user?: AuthUser,
  ) {
    return this.service.update(id, dto, user);
  }

  @ApiOperation({ summary: "Delete a Tag" })
  @ApiNoContentResponse({ description: "Tag deleted" })
  @ApiUnauthorizedResponse({ description: "Missing or invalid access token" })
  @ApiForbiddenResponse({ description: "Insufficient permissions" })
  @ApiNotFoundResponse({ description: "Record not found" })
  @ApiBearerAuth()
  @Roles("admin")
  @Delete(":id")
  @HttpCode(204)
  async remove(
    @Param("id", ParseUUIDPipe) id: string,
    @CurrentUser() user?: AuthUser,
  ): Promise<void> {
    await this.service.remove(id, user);
  }
}
