  {
    "content": "import { INestApplication, ValidationPipe } from "@nestjs/common";
import { Test } from "@nestjs/testing";
import { randomUUID } from "node:crypto";
import request from "supertest";
import { AppModule } from "../../src/app.module";
import { User } from "../../src/users/entities/user.entity";
import { UsersService } from "../../src/users/users.service";

export const TEST_PASSWORD = "Password123!";

export async function createTestApp(): Promise<INestApplication> {
  const moduleRef = await Test.createTestingModule({ imports: [AppModule] }).compile();
  const app = moduleRef.createNestApplication();
  app.setGlobalPrefix("api");
  app.useGlobalPipes(
    new ValidationPipe({
      whitelist: true,
      transform: true,
      transformOptions: { enableImplicitConversion: true },
    }),
  );
  await app.init();
  return app;
}

export async function createUser(app: INestApplication, roles: string[]): Promise<User> {
  const users = app.get(UsersService);
  const email = \`user-\${randomUUID()}@example.com\`;
  return users.create(email, TEST_PASSWORD, roles);
}

export async function login(
  app: INestApplication,
  email: string,
  password = TEST_PASSWORD,
): Promise<string> {
  const response = await request(app.getHttpServer()).post("/api/auth/login").send({
    email,
    password,
  });
  if (response.status !== 200) {
    throw new Error(
      \`Login failed for \${email}: \${response.status} \${JSON.stringify(response.body)}\`,
    );
  }
  return response.body.accessToken as string;
}

export function authHeader(token?: string | null): Record<string, string> {
  return token ? { Authorization: \`Bearer \${token}\` } : {};
}
",
    "path": "test/utils/auth.ts",
  },
  {
    "content": "import { randomUUID } from "node:crypto";

export function listItems(body: unknown): Array<Record<string, unknown>> {
  if (Array.isArray(body)) return body as Array<Record<string, unknown>>;
  if (body && typeof body === "object" && "data" in body) {
    const data = (body as { data?: unknown }).data;
    if (Array.isArray(data)) return data as Array<Record<string, unknown>>;
  }
  return [];
}

export function unique(prefix: string): string {
  return \`\${prefix}-\${randomUUID().slice(0, 8)}\`;
}
",
    "path": "test/utils/db.ts",
  },
  {
    "content": "import { INestApplication } from "@nestjs/common";
import { randomUUID } from "node:crypto";
import request from "supertest";
import { DataSource } from "typeorm";
import { authHeader } from "./auth";
import { Post } from "../../src/modules/post/post.entity";
import { Tag } from "../../src/modules/tag/tag.entity";
import { Comment } from "../../src/modules/comment/comment.entity";

export interface FactoryContext {
  app: INestApplication;
  dataSource: DataSource;
  tokens: { admin: string; owner: string; other: string; creator: string };
  ownerId: string;
}

export function createFactories(ctx: FactoryContext) {
  function sampleString(value: string, minLength: number, maxLength: number): string {
    const padded = value + "x".repeat(Math.max(0, minLength - value.length));
    return padded.slice(0, Math.max(minLength, maxLength));
  }

  async function buildPost(suffix: string): Promise<Record<string, unknown>> {
    const payload: Record<string, unknown> = {
      title: sampleString(\`\${"Post"} \${suffix}\`, 3, 160),
      slug: sampleString(\`\${"post"}-\${suffix}\`, 0, 180),
      content: sampleString(\`\${"Post"} \${suffix}\`, 1, 255),
      status: "draft",
      authorId: ctx.ownerId,
    };
    return payload;
  }

  async function makePost(
    suffix: string,
    token: string | null = ctx.tokens.creator,
  ): Promise<Post> {
    const payload = await buildPost(suffix);

    const response = await request(ctx.app.getHttpServer())
      .post("/api/posts")
      .set(authHeader(token))
      .send(payload);
    if (response.status !== 201) {
      throw new Error(\`Failed to create Post: \${response.status} \${JSON.stringify(response.body)}\`);
    }

    const row = response.body as Post;
    await ctx.dataSource.getRepository(Post).update(row.id, { ownerId: ctx.ownerId });
    return row;
  }

  async function buildTag(suffix: string): Promise<Record<string, unknown>> {
    const payload: Record<string, unknown> = {
      name: sampleString(\`\${"tag"}-\${suffix}\`, 0, 80),
    };
    return payload;
  }

  async function makeTag(suffix: string, token: string | null = ctx.tokens.creator): Promise<Tag> {
    const payload = await buildTag(suffix);

    const response = await request(ctx.app.getHttpServer())
      .post("/api/tags")
      .set(authHeader(token))
      .send(payload);
    if (response.status !== 201) {
      throw new Error(\`Failed to create Tag: \${response.status} \${JSON.stringify(response.body)}\`);
    }

    const row = response.body as Tag;
    return row;
  }

  async function buildComment(suffix: string): Promise<Record<string, unknown>> {
    const postPost = await makePost(\`\${suffix}-post\`);
    const payload: Record<string, unknown> = {
      body: sampleString(\`\${"Comment"} \${suffix}\`, 1, 255),
      postId: postPost.id,
    };
    return payload;
  }

  async function makeComment(
    suffix: string,
    token: string | null = ctx.tokens.creator,
  ): Promise<Comment> {
    const payload = await buildComment(suffix);

    const response = await request(ctx.app.getHttpServer())
      .post("/api/comments")
      .set(authHeader(token))
      .send(payload);
    if (response.status !== 201) {
      throw new Error(
        \`Failed to create Comment: \${response.status} \${JSON.stringify(response.body)}\`,
      );
    }

    const row = response.body as Comment;
    await ctx.dataSource.getRepository(Comment).update(row.id, { ownerId: ctx.ownerId });
    return row;
  }

  return {
    makePost,
    buildPost,
    makeTag,
    buildTag,
    makeComment,
    buildComment,
  };
}
