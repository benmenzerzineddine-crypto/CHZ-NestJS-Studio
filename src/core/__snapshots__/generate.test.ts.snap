  {
    "content": "import { applyAccessScope, AuthUser } from "../../common/access/access-context";
import { PaginatedResponse } from "../../common/interfaces/paginated-response.interface";
import { Comment } from "./comment.entity";
import { CreateCommentDto } from "./dto/create-comment.dto";
import { QueryCommentDto } from "./dto/query-comment.dto";
import { UpdateCommentDto } from "./dto/update-comment.dto";
import { BadRequestException, Injectable, NotFoundException } from "@nestjs/common";
import { InjectRepository } from "@nestjs/typeorm";
import { Repository } from "typeorm";

@Injectable()
export class CommentService {
  constructor(@InjectRepository(Comment) private readonly repository: Repository<Comment>) {}

  async findAll(query: QueryCommentDto, user?: AuthUser): Promise<PaginatedResponse<Comment>> {
    const qb = this.repository.createQueryBuilder("comment");
    qb.select([
      "comment.id",
      "comment.body",
      "comment.isApproved",
      "comment.createdAt",
      "comment.updatedAt",
      "comment.postId",
      "comment.ownerId",
    ]);
    if (query.body !== undefined)
      qb.andWhere("comment.body ILIKE :body", { body: \`%\${query.body}%\` });
    if (query.isApproved !== undefined)
      qb.andWhere("comment.isApproved = :isApproved", { isApproved: query.isApproved });
    if (query.search) {
      qb.andWhere("(comment.body ILIKE :search)", { search: \`%\${query.search}%\` });
    }
    const sortable = new Set<string>(["id", "createdAt", "updatedAt"]);
    const requestedSort = query.sort?.replace(/^[-+]/, "");
    if (requestedSort && !sortable.has(requestedSort)) {
      throw new BadRequestException(\`Invalid sort field: \${requestedSort}\`);
    }
    const sort = requestedSort ?? "createdAt";
    const order = query.sort?.startsWith("-")
      ? "DESC"
      : query.sort?.startsWith("+")
        ? "ASC"
        : query.order === "ASC"
          ? "ASC"
          : "DESC";
    qb.orderBy(\`comment.\${sort}\`, order);

    const page = query.page ?? 1;
    const limit = query.limit ?? 20;
    qb.skip((page - 1) * limit).take(limit);
    const [data, total] = await qb.getManyAndCount();
    return { data, meta: { page, limit, total, totalPages: Math.ceil(total / limit) } };
  }

  async findOne(id: string, user?: AuthUser): Promise<Comment> {
    const qb = this.repository.createQueryBuilder("comment").where("comment.id = :id", { id });
    const entity = await qb.getOne();
    if (!entity) throw new NotFoundException("Comment not found");
    return entity;
  }

  private async findForUpdate(id: string, user?: AuthUser): Promise<Comment> {
    const qb = this.repository.createQueryBuilder("comment").where("comment.id = :id", { id });
    applyAccessScope(qb, user, "ownerId", "admin");
    const entity = await qb.getOne();
    if (!entity) throw new NotFoundException("Comment not found");
    return entity;
  }

  private async findForDelete(id: string, user?: AuthUser): Promise<Comment> {
    const qb = this.repository.createQueryBuilder("comment").where("comment.id = :id", { id });
    const entity = await qb.getOne();
    if (!entity) throw new NotFoundException("Comment not found");
    return entity;
  }

  async create(dto: CreateCommentDto, user?: AuthUser): Promise<Comment> {
    const entity = this.repository.create();
    entity.body = dto.body;
    if (dto.isApproved !== undefined) entity.isApproved = dto.isApproved;
    entity.postId = dto.postId;
    if (user) entity.ownerId = user.id;
    return this.repository.save(entity);
  }

  async update(id: string, dto: UpdateCommentDto, user?: AuthUser): Promise<Comment> {
    const entity = await this.findForUpdate(id, user);
    if (dto.body !== undefined) entity.body = dto.body;
    if (dto.isApproved !== undefined) entity.isApproved = dto.isApproved;
    if (dto.postId !== undefined) entity.postId = dto.postId;
    return this.repository.save(entity);
  }

  async remove(id: string, user?: AuthUser): Promise<void> {
    const entity = await this.findForDelete(id, user);
    await this.repository.remove(entity);
  }
}
